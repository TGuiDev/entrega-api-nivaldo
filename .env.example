# Copie para .env e rode: node --env-file=.env src/server.js  (ou npm run start:env)
# Opção 1: string única
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/biblioteca

# Opção 2: variáveis separadas
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=biblioteca

# Segredo usado para assinar os tokens JWT (obrigatório em produção; gere com: openssl rand -hex 32)
JWT_SECRET=troque-por-um-valor-aleatorio
