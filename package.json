{
  "name": "api-biblioteca",
  "version": "1.0.0",
  "description": "API REST de Biblioteca (Node.js + Express + PostgreSQL) com front-end em Vite + TypeScript",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "front:install": "npm --prefix frontend install",
    "front:dev": "npm --prefix frontend run dev",
    "front:build": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "front:typecheck": "npm --prefix frontend exec tsc -- --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
